# Copy to .env for local standalone use: `cp .env.example .env && docker compose up -d`
# Coolify supplies these at deploy time — .env is never committed.

# The URL users reach the app on. Backend and frontend build absolute links from
# it, so a wrong value gives a working login page that redirects to the wrong host.
CISO_ASSISTANT_URL=https://localhost:8443

# Django ALLOWED_HOSTS: the public hostname users reach the app on, nothing else.
# Anything absent from this list gets a 400 "Invalid HTTP_HOST header". The two
# internal callers that use a container name instead (the backend healthcheck and
# the frontend's server-side API calls) are appended by the compose files, so do
# not add `backend` or `localhost` here.
ALLOWED_HOSTS=localhost

# Database. Note the asymmetry: the backend reads POSTGRES_NAME and DB_HOST/DB_PORT,
# while the postgres image initialises itself from POSTGRES_DB. The compose file
# feeds POSTGRES_NAME to both, so set it once here.
POSTGRES_NAME=ciso
POSTGRES_USER=ciso
POSTGRES_PASSWORD=change-me-a-real-secret-goes-in-coolify
